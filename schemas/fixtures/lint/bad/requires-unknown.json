{
    "$schema": "../../../loader-manifest.v1.schema.json",
    "app": "demo",
    "artifacts": {
        "profile": {
            "platform": "any",
            "sourceTemplate": "https://meta.example.org/{gameVersion}/{loaderVersion}/profile.json",
            "x-tmc-placeholder": "markers are allowed outside --release"
        }
    },
    "id": "demo/loader/basic",
    "kind": "loader",
    "loader": "basic",
    "requires": [
        "demo/loader/missing"
    ],
    "revision": 2,
    "schemaVersion": 1,
    "steps": [
        {
            "action": "download",
            "artifact": "profile",
            "to": {
                "path": "files/{launchVersionId}.json",
                "root": "layer"
            }
        }
    ],
    "title": "Basic loader",
    "vars": {
        "launchVersionId": "basic-{loaderVersion}-{gameVersion}"
    }
}
