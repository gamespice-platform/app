{
    "$schema": "../../../schemas/loader-manifest.v1.schema.json",
    "app": "minecraft",
    "artifacts": {
        "installer": {
            "description": "The Quilt installer",
            "platform": "any",
            "sides": [
                "server"
            ],
            "urlTemplate": "https://maven.quiltmc.org/repository/release/org/quiltmc/quilt-installer/{var.installerVersion}/quilt-installer-{var.installerVersion}.jar"
        },
        "profileJson": {
            "description": "Launcher profile JSON, mirrored by the importer",
            "platform": "any",
            "sides": [
                "client"
            ],
            "sourceTemplate": "https://meta.quiltmc.org/v3/versions/loader/{gameVersion}/{loaderVersion}/profile/json"
        }
    },
    "downloadHosts": [
        "maven.quiltmc.org"
    ],
    "id": "minecraft/loader/quilt",
    "kind": "loader",
    "launch": {
        "vars": [
            "launchVersionId",
            "serverJar"
        ]
    },
    "loader": "quilt",
    "requirements": {
        "runtimes": [
            {
                "for": "install",
                "kind": "java",
                "major": "{var.javaMajor}"
            }
        ]
    },
    "requires": [
        "minecraft/version"
    ],
    "revision": 1,
    "schemaVersion": 1,
    "steps": [
        {
            "action": "download",
            "artifact": "profileJson",
            "to": {
                "path": "files/versions/{launchVersionId}/{launchVersionId}.json",
                "root": "layer"
            },
            "when": {
                "side": "client"
            }
        },
        {
            "action": "download",
            "artifact": "installer",
            "to": {
                "path": "quilt-installer-{var.installerVersion}.jar",
                "root": "downloads"
            },
            "when": {
                "side": "server"
            }
        },
        {
            "action": "runInstaller",
            "args": [
                "-jar",
                "{artifact.installer}",
                "install",
                "server",
                "{gameVersion}",
                "{loaderVersion}",
                "--download-server",
                "--install-dir={layerFiles}"
            ],
            "cwd": "{layerWork}",
            "expectFiles": [
                {
                    "path": "files/quilt-server-launch.jar",
                    "root": "layer"
                }
            ],
            "network": true,
            "program": "{runtime.java}",
            "timeoutSecs": 1800,
            "when": {
                "side": "server"
            }
        }
    ],
    "title": "Quilt",
    "vars": {
        "launchVersionId": "quilt-loader-{loaderVersion}-{gameVersion}",
        "serverJar": "quilt-server-launch.jar"
    }
}
