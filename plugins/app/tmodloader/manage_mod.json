{
    "manifestVersion": 1,
    "label": "tModLoader mod (.tmod)",
    "description": "A built mod into the Mods folder of tModLoader's save data. Each mod is one .tmod file; which ones are enabled is kept in enabled.json beside them.",
    "match": {
        "extensions": [
            "tmod"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "Mods",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "mkdir",
                "path": {
                    "root": "gameDir",
                    "path": "Mods"
                }
            },
            {
                "action": "move",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "Mods/{fileName}"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "gameDir",
                    "path": "Mods/{fileName}"
                }
            }
        ]
    }
}
