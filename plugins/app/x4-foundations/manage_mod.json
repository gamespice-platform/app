{
    "manifestVersion": 1,
    "label": "X4: Foundations mod archive (.zip)",
    "description": "Each extension is a folder under extensions with a content.xml. Archives are unpacked flat, so each zip must already contain the extension folder.",
    "match": {
        "extensions": [
            "zip",
            "7z",
            "rar"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "extensions",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "mkdir",
                "path": {
                    "root": "gameDir",
                    "path": "extensions"
                }
            },
            {
                "action": "extract",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "extensions"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "pluginData",
                    "path": "staging/{itemId}"
                }
            }
        ]
    }
}
