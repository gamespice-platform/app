{
    "manifestVersion": 1,
    "label": "Pillars of Eternity II: Deadfire mod (zip)",
    "description": "A mod unpacked into a folder of its own under the game's override folder.",
    "match": {
        "extensions": [
            "zip"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "PillarsOfEternityII_Data/override",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "extract",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "PillarsOfEternityII_Data/override/{itemId}"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "gameDir",
                    "path": "PillarsOfEternityII_Data/override/{itemId}"
                }
            }
        ]
    }
}
