{
    "manifestVersion": 1,
    "label": "GreedFall mod archive",
    "description": "Unpacked FLAT into datalocal: the archive already carries the mod's own folder (or files) at its top level, and the game looks for exactly those paths, so there is no folder-per-mod to retreat to. Uninstalling is precise because the executor's journal records every file the extract wrote.",
    "match": {
        "extensions": [
            "zip",
            "7z",
            "rar"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "datalocal",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "mkdir",
                "path": {
                    "root": "gameDir",
                    "path": "datalocal"
                }
            },
            {
                "action": "extract",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "datalocal"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "pluginData",
                    "path": "staging/{itemId}"
                }
            }
        ]
    }
}
