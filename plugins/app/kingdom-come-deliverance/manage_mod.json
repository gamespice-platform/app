{
    "manifestVersion": 1,
    "label": "Kingdom Come: Deliverance mod archive (.zip)",
    "description": "Each mod is a folder under Mods holding a mod.manifest and a Data subfolder of .pak files. Archives are unpacked flat, so each zip must already contain the mod folder.",
    "match": {
        "extensions": [
            "zip",
            "7z",
            "rar"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "Mods",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "mkdir",
                "path": {
                    "root": "gameDir",
                    "path": "Mods"
                }
            },
            {
                "action": "extract",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "Mods"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "pluginData",
                    "path": "staging/{itemId}"
                }
            }
        ]
    }
}
