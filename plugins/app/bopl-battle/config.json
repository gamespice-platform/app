{
    "manifestVersion": 1,
    "label": "Bopl Battle settings files",
    "description": "Where BepInEx keeps the settings each mod writes on first run.",
    "config": {
        "locations": [
            {
                "label": "Mod settings",
                "root": "gameDir",
                "path": "BepInEx/config",
                "extensions": [
                    "cfg",
                    "json",
                    "yaml",
                    "yml",
                    "toml"
                ],
                "recursive": true
            }
        ]
    }
}
