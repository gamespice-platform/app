{
    "manifestVersion": 1,
    "label": "Sledding Game settings files",
    "description": "Where MelonLoader keeps the settings each mod writes on first run.",
    "config": {
        "locations": [
            {
                "label": "Mod settings",
                "root": "gameDir",
                "path": "UserData",
                "extensions": [
                    "cfg",
                    "json",
                    "toml",
                    "ini"
                ],
                "recursive": true
            }
        ]
    }
}
