{
    "manifestVersion": 1,
    "label": "Noita mod (.zip)",
    "description": "Unpacked into a folder of its own under mods/. Noita lists each subfolder as one mod (it reads mod.xml), so a mod IS its folder. Enabling it is done in the game's Mods menu.",
    "match": {
        "extensions": [
            "zip",
            "7z"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "mods",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "extract",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "mods/{itemId}"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "gameDir",
                    "path": "mods/{itemId}"
                }
            }
        ]
    }
}
