{
    "manifestVersion": 1,
    "label": "FANTASY LIFE i: The Girl Who Steals Time mod file (.pak, .ucas, .utoc)",
    "description": "Unreal .pak files (with their .ucas/.utoc companions) in a ~mods folder inside Content/Paks.",
    "match": {
        "extensions": [
            "pak",
            "ucas",
            "utoc"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "Game/Content/Paks/~mods",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "mkdir",
                "path": {
                    "root": "gameDir",
                    "path": "Game/Content/Paks/~mods"
                }
            },
            {
                "action": "move",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "Game/Content/Paks/~mods/{fileName}"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "gameDir",
                    "path": "Game/Content/Paks/~mods/{fileName}"
                }
            }
        ]
    }
}
