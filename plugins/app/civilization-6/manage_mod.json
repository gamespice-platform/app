{
    "manifestVersion": 1,
    "label": "Civilization VI mod (.zip)",
    "description": "Unpacked into a folder of its own under Mods in the game's documents folder. The game reads each subfolder that has a .modinfo.",
    "match": {
        "extensions": [
            "zip",
            "7z"
        ]
    },
    "permissions": {
        "fs": [
            {
                "root": "pluginData",
                "path": "",
                "write": true
            },
            {
                "root": "gameDir",
                "path": "Mods",
                "write": true
            }
        ]
    },
    "manage": {
        "install": [
            {
                "action": "download",
                "url": "{fileUrl}",
                "to": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                }
            },
            {
                "action": "extract",
                "from": {
                    "root": "pluginData",
                    "path": "staging/{itemId}/{fileName}"
                },
                "to": {
                    "root": "gameDir",
                    "path": "Mods/{itemId}"
                }
            }
        ],
        "uninstall": [
            {
                "action": "remove",
                "path": {
                    "root": "gameDir",
                    "path": "Mods/{itemId}"
                }
            }
        ]
    }
}
