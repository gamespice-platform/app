{
    "manifestVersion": 1,
    "manager": {
        "id": "prism",
        "label": "Prism Launcher",
        "homepage": "https://prismlauncher.org/",
        "notes": [
            "Reads the jars in each Prism instance's mods folder, one entry per instance. This descriptor covers instances whose game folder is 'minecraft'.",
            "Instances using the older '.minecraft' folder name are covered by the prism-dotminecraft descriptor, because a layout may hold only one wildcard.",
            "Flatpak installs keep their data under ~/.var/app/org.prismlauncher.PrismLauncher."
        ],
        "roots": [
            {
                "platform": "windows",
                "base": "appData",
                "path": "PrismLauncher"
            },
            {
                "platform": "linux",
                "base": "localData",
                "path": "PrismLauncher"
            },
            {
                "platform": "linux",
                "base": "home",
                "path": ".var/app/org.prismlauncher.PrismLauncher/data/PrismLauncher"
            },
            {
                "platform": "macos",
                "base": "config",
                "path": "PrismLauncher"
            }
        ],
        "layout": {
            "modsPath": "instances/*/minecraft/mods",
            "entry": "archive",
            "ignore": [
                "instgroups.json"
            ]
        },
        "games": [
            {
                "dir": "minecraft",
                "slug": "minecraft",
                "relPath": "mods"
            }
        ]
    }
}
