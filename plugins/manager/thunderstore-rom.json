{
    "manifestVersion": 1,
    "manager": {
        "id": "thunderstore-rom",
        "label": "Thunderstore Mod Manager (ReturnOfModding)",
        "homepage": "https://www.overwolf.com/app/Thunderstore-Thunderstore_Mod_Manager",
        "notes": [
            "The Overwolf build of r2modman. Same profile layout, different folder - both are listed separately because a machine can have both.",
            "Nothing is moved: the mods stay in Thunderstore Mod Manager and this app takes a copy.",
            "Descriptor for games that use ReturnOfModding: its mods live in ReturnOfModding/plugins inside each profile."
        ],
        "roots": [
            {
                "base": "config",
                "path": "Thunderstore Mod Manager/DataFolder"
            }
        ],
        "layout": {
            "modsPath": "{game}/profiles/*/ReturnOfModding/plugins",
            "entry": "directory",
            "ignore": [
                "_state",
                "MMHOOK"
            ]
        },
        "games": [
            {
                "dir": "HadesII",
                "slug": "hades-ii",
                "relPath": "ReturnOfModding/plugins"
            },
            {
                "dir": "RiskofRainReturns",
                "slug": "risk-of-rain-returns",
                "relPath": "ReturnOfModding/plugins"
            }
        ],
        "metadata": {
            "file": "manifest.json",
            "name": "/name",
            "version": "/version_number",
            "author": "/author",
            "website": "/website_url"
        }
    }
}
