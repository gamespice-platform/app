{
    "manifestVersion": 1,
    "manager": {
        "id": "thunderstore-rivet",
        "label": "Thunderstore Mod Manager (Rivet)",
        "homepage": "https://www.overwolf.com/app/Thunderstore-Thunderstore_Mod_Manager",
        "notes": [
            "The Overwolf build of r2modman. Same profile layout, different folder - both are listed separately because a machine can have both.",
            "Nothing is moved: the mods stay in Thunderstore Mod Manager and this app takes a copy.",
            "Descriptor for games that use Rivet: its mods live in Rivet/Mods inside each profile."
        ],
        "roots": [
            {
                "base": "config",
                "path": "Thunderstore Mod Manager/DataFolder"
            }
        ],
        "layout": {
            "modsPath": "{game}/profiles/*/Rivet/Mods",
            "entry": "directory",
            "ignore": [
                "_state",
                "MMHOOK"
            ]
        },
        "games": [
            {
                "dir": "ScrapMechanic",
                "slug": "scrap-mechanic",
                "relPath": "Rivet/Mods"
            }
        ],
        "metadata": {
            "file": "manifest.json",
            "name": "/name",
            "version": "/version_number",
            "author": "/author",
            "website": "/website_url"
        }
    }
}
